#!/bin/sh
# usage: volume up|down|mute
# Change the default output's volume and show a dunst popup with a progress
# bar (the popup replaces itself instead of stacking).

case $1 in
up) pactl set-sink-mute @DEFAULT_SINK@ 0; pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
down) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
*) echo "usage: volume up|down|mute" >&2; exit 1 ;;
esac

vol=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -1 | tr -d %)
muted=$(pactl get-sink-mute @DEFAULT_SINK@ | grep -c yes)
sink=$(pactl -f json list sinks 2>/dev/null | python3 -c '
import json, subprocess, sys
d = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True).stdout.strip()
print(next((s["description"] for s in json.load(sys.stdin) if s["name"] == d), ""))' 2>/dev/null)

if [ "$muted" -eq 1 ]; then
    icon=audio-volume-muted-symbolic; title="Muted"
elif [ "$vol" -lt 34 ]; then
    icon=audio-volume-low-symbolic; title="Volume $vol%"
elif [ "$vol" -lt 67 ]; then
    icon=audio-volume-medium-symbolic; title="Volume $vol%"
else
    icon=audio-volume-high-symbolic; title="Volume $vol%"
fi

dunstify -a volume -u normal -i "$icon" \
    -h string:x-dunst-stack-tag:volume -h "int:value:$vol" \
    "$title" "$sink"
